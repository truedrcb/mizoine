{
  "name": "mizoine-codemirror-bundle",
  "private": true,
  "description": "Builds src/main/resources/ui/vendor/codemirror.js (DEV.md step 39): npm ci && npm run build. Only when the editor is updated; not part of mvn verify.",
  "type": "module",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --target=es2022 --outfile=../../src/main/resources/ui/vendor/codemirror.js && node -e \"require('fs').copyFileSync('node_modules/codemirror/LICENSE', '../../src/main/resources/ui/vendor/codemirror.LICENSE.txt')\""
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
