# Build output
/target/
**/node_modules/

# IDEs and editors
/.classpath
.project
/.settings/
**/.factorypath
/.sts4-cache
.idea
mizoine.iml
**/.vscode

# AI agents and quality tools
# Claude Code: local settings and skills
/.claude/
# ub-mode tools (crapper, dryer, mutator): snapshots
/.metrics/

# A local Mizoine: its real data, not samples
# real users file with password hashes (sample: users.example.yaml)
/users.yaml
# real repositories folder (sample: repositories.example/)
/repositories/
**/.mizoine
# the archived earlier version
/archive/mizoine0/

# Sensitive files (AGENTS.md): never in version control
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.asc
*.pgp
*.kdbx
secrets.yaml
secrets.yml
secrets.json
*.secret.*
.aws/
credentials
# No bare "config": it would also hide the source folders named config (Java package, test resources).

# Except test and sample files: no real credentials (AGENTS.md); test keys and certificates may be committed
!/src/test/resources/**
